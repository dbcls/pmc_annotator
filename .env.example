# Copy to .env and fill in. NEVER commit the real .env.

# NCBI E-utilities (T3 existence verification). Optional but raises rate limits.
NCBI_API_KEY=

# Azure OpenAI (fallback backend for role classification). Leave blank if using local vLLM.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Local OpenAI-compatible server (vLLM/Ollama) for role_llm_run --backend oss.
# e.g. http://localhost:8001
OPENAI_BASE_URL=
